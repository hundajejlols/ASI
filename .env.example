# =============================================================================
# Attack Surface Intelligence (AGH) - Konfiguracja środowiska
# Skopiuj do .env i uzupełnij własnymi sekretami przed uruchomieniem.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=asi_user
POSTGRES_PASSWORD=changeme_strong_db_password
POSTGRES_DB=asi_db
DATABASE_URL=postgresql+psycopg://asi_user:changeme_strong_db_password@postgres:5432/asi_db

# --- Redis (chroniony hasłem) ---
REDIS_PASSWORD=changeme_strong_redis_password
REDIS_URL=redis://:changeme_strong_redis_password@redis:6379/0
REDIS_JOB_QUEUE=asi:scan:chunks

# --- Security, JWT & Encryption At Rest (AES-256-GCM) ---
# Wygeneruj losowy klucz 32-bajtowy (base64):
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Ustaw na false w środowisku produkcyjnym (odrzuca domyślny zerowy klucz szyfrowania)
ALLOW_WEAK_ENCRYPTION_KEY=true
# Ustaw na false w środowisku produkcyjnym (wymusza wyłącznie logowanie JWT Bearer zamiast X-Dev-Role)
ALLOW_DEV_ROLE_HEADER=true
JWT_SECRET_KEY=changeme_generate_random_jwt_secret_min_32_chars
JWT_EXPIRE_MINUTES=480

# --- Scanner Worker ---
# Puste SCANNER_WORKER_ID powoduje automatyczne użycie nazwy hosta kontenera (wymagane przy --scale scanner=N)
SCANNER_WORKER_ID=
SCANNER_CHUNK_WORKERS=2
SCANNER_CONCURRENCY=4
SCANNER_RATE_LIMIT_PPS=300
SCANNER_HTTP_MAX_RPS=20
SCANNER_HTTP_TIMEOUT_SEC=5
BACKEND_INGEST_URL=http://backend:8000/api/v1/scans/ingest
SCANNER_INTERNAL_TOKEN=changeme_internal_scanner_token

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
